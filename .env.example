# GEMINI_API_KEY: Required for AI-Assisted Medical Record Summarization.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign authentication tokens and sessions.
SESSION_SECRET="replace_with_secure_random_64_byte_hex_secret"

# ADMIN_SETUP_KEY: Optional setup passcode for initial Administrator provisioning when 0 admins exist.
ADMIN_SETUP_KEY="HEALTHLINK-ADMIN-SETUP"

# MYSQL CONFIGURATION (For Python Flask / MySQL deployment in /backend)
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="healthlink_user"
MYSQL_PASSWORD="replace_with_mysql_password"
MYSQL_DATABASE="healthlink_abha_db"

# ABDM / ABHA GATEWAY CONFIGURATION (Optional — leave empty unless connected to official ABDM Sandbox)
ABDM_SANDBOX_ENABLED="false"
ABDM_CLIENT_ID=""
ABDM_CLIENT_SECRET=""
